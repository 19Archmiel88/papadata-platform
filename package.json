{
  "name": "papadata-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @papadata/api --filter @papadata/bff --filter @papadata/worker run dev:production",
    "dev:api": "pnpm --filter @papadata/api dev:production",
    "dev:bff": "pnpm --filter @papadata/bff dev:production",
    "dev:worker": "pnpm --filter @papadata/worker dev:production",
    "typecheck": "turbo run typecheck",
    "typecheck:backend": "pnpm --filter @papadata/contracts --filter @papadata/database --filter @papadata/integrations --filter @papadata/storage --filter @papadata/ai-runtime --filter @papadata/api --filter @papadata/bff --filter @papadata/worker run typecheck",
    "build": "turbo run build",
    "build:backend": "pnpm --filter @papadata/contracts --filter @papadata/database --filter @papadata/integrations --filter @papadata/storage --filter @papadata/ai-runtime --filter @papadata/api --filter @papadata/bff --filter @papadata/worker run build",
    "test": "pnpm test:backend",
    "test:backend": "node tools/verify-backend-tests.mjs",
    "test:unit": "pnpm --filter @papadata/contracts --filter @papadata/database --filter @papadata/api --filter @papadata/bff --filter @papadata/web run test",
    "verify": "pnpm verify:backend",
    "verify:backend": "node tools/verify-backend-gate.mjs",
    "verify:authorization-audit": "pnpm --filter @papadata/api exec vitest run src/production/auth/route-policy-reader.test.ts src/production/auth/audit-coverage-registry.test.ts src/production/auth/capability.guard.test.ts src/production/auth/denied-access-audit.service.test.ts src/production/audit/audit.service.test.ts src/production/audit/audit.controller.test.ts src/production/audit/audit-metadata-safety.test.ts src/production/reports/report.controller.audit.test.ts",
    "verify:backend-release": "node tools/verify-backend-release-scope.mjs",
    "verify:backend-security": "node tools/verify-backend-security-controls.mjs",
    "verify:migration-parity": "sh tools/verify-migration-parity.sh",
    "verify:production-parity-env": "node tools/verify-production-parity-env-contract.mjs",
    "verify:production-parity-runtime": "pnpm verify:production-parity-env && pnpm test:backend-production-parity",
    "verify:licenses": "mkdir -p artifacts/backend-evidence && pnpm licenses list --prod --json > artifacts/backend-evidence/licenses.json && node tools/check-license-report.mjs artifacts/backend-evidence/licenses.json",
    "evidence:backend": "node tools/generate-backend-evidence.mjs",
    "start:local": "docker compose --env-file .env.example up --build api worker",
    "migrate": "docker compose --env-file .env.example run --rm migrate up",
    "migrate:status": "docker compose --env-file .env.example run --rm migrate status",
    "test:migrations": "docker compose --env-file .env.example run --rm migrate test",
    "test:backend-production-parity": "node tests/backend-production-parity/e2e.mjs",
    "security:audit": "pnpm audit --prod",
    "security:check": "pnpm audit --prod && pnpm build",
    "start:production-parity": "pnpm prepare:production-parity && docker compose -f compose.production-parity.yml --env-file .env.production-parity up --build",
    "stop:production-parity": "docker compose -f compose.production-parity.yml --env-file .env.production-parity down",
    "storybook": "pnpm --filter @papadata/web storybook",
    "build-storybook": "pnpm --filter @papadata/web build-storybook",
    "prepare:production-parity": "sh tools/prepare-production-parity.sh",
    "generate:production-parity-env-example": "node tools/generate-production-parity-env-example.mjs"
  },
  "devDependencies": {
    "tsx": "4.23.12",
    "turbo": "2.10.9",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "gaxios>uuid": "11.1.1",
      "find-my-way": "9.7.0",
      "minimatch@9.0.9>brace-expansion": "2.1.4",
      "minimatch@10.2.5>brace-expansion": "5.0.9",
      "teeny-request>uuid": "11.1.1",
      "fast-uri@3.1.4": "3.1.5",
      "fast-uri@4.1.1": "4.1.2",
      "postcss": "8.5.26",
      "nanoid": "3.3.18"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.29.3"
  }
}
