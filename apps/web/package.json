{
  "name": "@papadata/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry --ci",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry",
    "generate-storybook-catalog": "node ../../scripts/generate-storybook-catalog.mjs",
    "check-storybook-catalog": "node ../../scripts/check-storybook-catalog.mjs && node ../../scripts/check-storybook-visual-reset.mjs --self-test && node ../../scripts/check-storybook-taxonomy.mjs --self-test",
    "generate-storybook-taxonomy-doc": "node ../../scripts/check-storybook-taxonomy.mjs --write-doc",
    "check-storybook-taxonomy": "node ../../scripts/check-storybook-taxonomy.mjs --self-test",
    "check-storybook-visual-reset": "node ../../scripts/check-storybook-visual-reset.mjs --self-test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "storybook": "^10.5.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
