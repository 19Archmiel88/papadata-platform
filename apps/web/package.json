{
  "name": "@papadata/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "storybook": "storybook dev -p 6010 --host 0.0.0.0 --exact-port --no-open --disable-telemetry --ci",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry",
    "generate-storybook-catalog": "node ../../scripts/generate-storybook-catalog.mjs",
    "check-storybook-catalog": "node ../../scripts/check-storybook-catalog.mjs && node ../../scripts/check-storybook-architecture.mjs --self-test && node ../../scripts/check-storybook-taxonomy.mjs --self-test",
    "generate-storybook-taxonomy-doc": "node ../../scripts/check-storybook-taxonomy.mjs --write-doc",
    "check-storybook-taxonomy": "node ../../scripts/check-storybook-taxonomy.mjs --self-test",
    "check-storybook-architecture": "node ../../scripts/check-storybook-architecture.mjs --self-test",
    "check-foundation-system": "node ../../scripts/check-foundation-system-v1.mjs",
    "check-component-system": "node ../../scripts/check-component-system-v1.mjs && node ../../scripts/check-storybook-presentation-contract.mjs && node ../../scripts/check-design-system-ownership.mjs",
    "verify-foundation-system": "node ../../scripts/verify-foundation-system-readonly.mjs",
    "capture-foundation-evidence": "node ../../scripts/capture-foundation-evidence.mjs",
    "check-storybook-presentation": "node ../../scripts/check-storybook-presentation-contract.mjs",
    "check-design-system-ownership": "node ../../scripts/check-design-system-ownership.mjs",
    "check-analytics-system": "node ../../scripts/check-analytics-system-v1.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "storybook": "^10.5.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
