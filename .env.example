# Local example configuration only. Do not commit real secrets.
# VITE_* values are embedded in the public browser bundle after build.
# Never put API keys, provider tokens, passwords or private material in VITE_*.

COMPOSE_PROJECT_NAME=papadata-local

POSTGRES_VERSION=18
POSTGRES_ADMIN_USER=papadata_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-only
POSTGRES_ADMIN_DATABASE=postgres
POSTGRES_PORT=5432

PAPADATA_DATABASE=papadata
PAPADATA_TEST_DATABASE=papadata_test
PAPADATA_MIGRATOR_USER=papadata_migrator
PAPADATA_MIGRATOR_PASSWORD=change-me-local-only
PAPADATA_APP_USER=papadata_app
PAPADATA_APP_PASSWORD=change-me-local-only
PAPADATA_TEST_USER=papadata_test
PAPADATA_TEST_PASSWORD=change-me-local-only

REDIS_VERSION=7
REDIS_PORT=6379

API_PORT=3001
WORKER_HEALTH_PORT=3002

VITE_PUBLIC_APP_ENV=local
VITE_ENABLE_MSW=false
VITE_ENABLE_MOCKS=false
