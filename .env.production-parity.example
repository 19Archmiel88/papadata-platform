NODE_ENV=production
POSTGRES_PASSWORD=replace-with-random-migrator-secret
PAPADATA_APP_PASSWORD=replace-with-random-application-secret
PAPADATA_PLATFORM_PASSWORD=replace-with-random-platform-secret
PAPADATA_TEST_PASSWORD=replace-with-random-test-secret
MINIO_ROOT_USER=papadata-parity
MINIO_ROOT_PASSWORD=replace-with-random-minio-secret

DATABASE_URL=postgresql://papadata_app:replace-with-random-application-secret@postgres-production:5432/papadata
SCHEDULER_DATABASE_URL=postgresql://papadata_platform:replace-with-random-platform-secret@postgres-production:5432/papadata
REDIS_URL=rediss://default:replace-with-redis-secret@redis-production:6379
REDIS_CA_BASE64=replace-with-base64-ca

PAPADATA_STORAGE_DRIVER=minio
PAPADATA_STORAGE_BUCKET=papadata-artifacts
PAPADATA_STORAGE_ENDPOINT=http://minio:9000
PAPADATA_STORAGE_ACCESS_KEY=papadata-parity
PAPADATA_STORAGE_SECRET_KEY=replace-with-random-minio-secret

PAPADATA_API_AUTH_ACTIVE_SECRET=replace-with-32-byte-random-api-secret-0001
PAPADATA_API_AUTH_PREVIOUS_SECRET=replace-with-32-byte-random-api-secret-0002
PAPADATA_API_AUTH_ISSUER=papadata-bff
PAPADATA_API_AUTH_AUDIENCE=papadata-api
PAPADATA_INFRASTRUCTURE_AUTH_TOKEN=replace-with-32-byte-random-infra-token
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

BFF_PORT=3001
API_ORIGIN=http://api-production:4000
BFF_ALLOWED_ORIGINS=https://localhost.example
BFF_PUBLIC_HOSTS=localhost.example
BFF_COOKIE_SECRET=replace-with-32-byte-random-cookie-secret-01
BFF_COOKIE_PREVIOUS_SECRET=replace-with-32-byte-random-cookie-secret-02
BFF_CSRF_SECRET=replace-with-32-byte-random-csrf-secret-0001
BFF_INTERNAL_AUTH_ACTIVE_SECRET=replace-with-32-byte-random-internal-01
BFF_INTERNAL_AUTH_PREVIOUS_SECRET=replace-with-32-byte-random-internal-02
BFF_INTERNAL_AUTH_ISSUER=papadata-bff
BFF_INTERNAL_AUTH_AUDIENCE=papadata-api
BFF_SESSION_STORE=redis-auth-state
