{
  "name": "@papadata/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./saved-reports": {
      "types": "./dist/saved-reports.d.ts",
      "import": "./dist/saved-reports.js"
    },
    "./decisions": {
      "types": "./dist/decisions.d.ts",
      "import": "./dist/decisions.js"
    },
    "./campaign-growth": {
      "types": "./dist/campaign-growth.d.ts",
      "import": "./dist/campaign-growth.js"
    },
    "./report-projections": {
      "types": "./dist/report-projections.d.ts",
      "import": "./dist/report-projections.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.29.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "vitest": "^5.0.0"
  }
}
