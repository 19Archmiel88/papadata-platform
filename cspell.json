{
  "version": "0.2",
  "language": "en,pl",
  "import": ["@cspell/dict-pl_pl/cspell-ext.json"],
  "dictionaries": ["pl-pl", "en_US", "papadata-custom"],
  "dictionaryDefinitions": [
    {
      "name": "papadata-custom",
      "path": "./.cspell/papadata-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "node_modules/**",
    "**/.turbo/**",
    "**/coverage/**",
    "docs/source-materials/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    "**/playwright-report/**",
    "**/storybook-static/**",
    "**/test-results/**",
    ".next/**",
    "coverage/**",
    "*.lock",
    "pnpm-lock.yaml"
  ]
}
