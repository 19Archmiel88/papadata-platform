{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/markdownlint-cli2-config-schema.json",
  "gitignore": true,
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/coverage/**",
    "docs/source-materials/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ]
}
