{
  "name": "@papadata/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-isolation=process authHttpRuntime.test.mjs accessHttpRuntime.test.mjs complianceHttpRuntime.test.mjs integrationDataCore.test.mjs metricEngineCore.test.mjs remainingBackendCore.test.mjs",
    "start:local": "node local-runtime.mjs",
    "healthcheck": "node healthcheck.mjs"
  },
  "dependencies": {
    "@papadata/contracts": "workspace:*",
    "@papadata/database": "workspace:*"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.29.3"
  }
}
