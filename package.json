{
  "name": "papadata-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @papadata/web dev",
    "storybook": "pnpm --filter @papadata/web storybook",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e:auth": "pnpm --filter @papadata/web test:e2e:auth",
    "test:storybook": "pnpm --filter @papadata/web test:storybook",
    "build": "turbo run build",
    "build:storybook": "pnpm --filter @papadata/web build:storybook",
    "preview": "pnpm --filter @papadata/web preview",
    "verify": "pnpm lint && pnpm typecheck && pnpm spell && pnpm markdownlint && pnpm test",
    "build-storybook": "pnpm build:storybook",
    "spell": "cspell \"**/*.{ts,tsx,md,css}\"",
    "markdownlint": "markdownlint-cli2"
  },
  "devDependencies": {
    "@cspell/dict-pl_pl": "^3.0.6",
    "cspell": "^10.0.1",
    "cspell-cli": "^10.0.1",
    "markdownlint-cli2": "^0.23.1",
    "turbo": "2.10.5",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.29.3"
  }
}
