# Local / GCP parity
APP_ENV=local
DATABASE_URL=postgresql://papadata:papadata@localhost:5432/papadata
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=papadata-local

# AI (Papa Assistant remote provider -- these are the real variable names read
# by apps/api/src/production/assistant-workspace/assistant-run.service.ts;
# AI_PROVIDER/AI_EXTERNAL_*/AI_MODEL/AI_TIMEOUT_MS/AI_MAX_REQUEST_COST were
# never actually read by any code. Disabled by default (PAPADATA_PAPA_REMOTE_
# ENABLED != 'true') so `docker compose up` never depends on a paid provider --
# assistant-run.service.ts's providerConfig() falls back to
# LocalDeterministicProvider whenever remote is disabled.)
PAPADATA_PAPA_REMOTE_ENABLED=false
PAPADATA_PAPA_REMOTE_ENDPOINT=
PAPADATA_PAPA_REMOTE_API_KEY=
PAPADATA_PAPA_REMOTE_MODEL=
PAPADATA_PAPA_REMOTE_ALLOWED_HOSTS=
PAPADATA_PAPA_REMOTE_RESERVE_MINOR_PER_CALL=50

# GUS/BIR
GUS_BIR_MODE=mock
GUS_BIR_BASE_URL=
GUS_BIR_API_KEY=
GUS_BIR_TIMEOUT_MS=10000
GUS_BIR_CACHE_TTL_SECONDS=86400

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MERCHANT_ID=
PAYMENT_CURRENCY=PLN
PAYMENT_ENABLE_CARD=true
PAYMENT_ENABLE_BLIK=true
PAYMENT_ENABLE_BLIK_RECURRING=true
PAYMENT_ENABLE_FAST_TRANSFER=true
PAYMENT_ENABLE_BANK_TRANSFER=true
PAYMENT_ENABLE_APPLE_PAY=true
PAYMENT_ENABLE_GOOGLE_PAY=true

# KSeF
KSEF_ENV=demo
KSEF_BASE_URL=
KSEF_AUTH_MODE=certificate
KSEF_CERTIFICATE_REF=
KSEF_NIP_CONTEXT=
KSEF_TIMEOUT_MS=30000
KSEF_RETRY_POLICY=exponential

# Mobile store links
IOS_APP_STORE_URL=
ANDROID_GOOGLE_PLAY_URL=
MOBILE_SMART_LINK_URL=
